{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mab-Compass",
  "version": "2.0.0",
  "identifier": "com.mabos.compass",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Mab-Compass v3.0 — Outcome, WorkLine & Knowledge Engine",
        "width": 1220,
        "height": 780,
        "minWidth": 640,
        "minHeight": 520,
        "resizable": true,
        "decorations": false,
        "transparent": false,
        "center": true,
        "alwaysOnTop": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
